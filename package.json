{
  "name": "painel-operacao-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "start:frontend": "npm --prefix apps/frontend run start",
    "start:backend": "npm --prefix apps/backend run start",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "lint:backend": "npm --prefix apps/backend run lint",
    "typecheck:frontend": "npx tsc --project apps/frontend/tsconfig.json --noEmit"
  }
}
